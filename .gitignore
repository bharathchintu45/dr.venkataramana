# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js — /.next-build/ is the alternate distDir used by
# `NEXT_DIST_DIR=.next-build npm run build`, so a production build can run
# without clobbering the .next a dev server is using (see next.config.mjs).
/.next/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / tool configs
.claude/
parsed_cv.txt

# Large Word / raw CV files (optional to exclude or keep)
*.docx

# Raw drone-flight source frames (26MB) — processed copies live in
# public/images/hero-flight/, see scripts/process-hero-frames.mjs
/ezgif-*-png-split/

# Raw, uncropped photo source dump (17GB) — every photo the site actually
# serves has already been resized/converted into public/images/, which is
# committed in full. This folder is source material for regenerating those,
# never itself requested by the site, and far too large to push.
/content and images/

# Editor / local tool config and debug artifacts
.vscode/
.playwright-mcp/
