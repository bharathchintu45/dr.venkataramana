# Copy this file to .env.local and fill in real values. Neither file
# should be committed — .env.local is already covered by .gitignore's
# ".env*.local" rule.

# Public site URL, used for absolute Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# The contact form submits by opening a WhatsApp deep link (wa.me) built
# from profileData.contactPhone in src/data/profile.ts — no endpoint or
# env var needed for it.
